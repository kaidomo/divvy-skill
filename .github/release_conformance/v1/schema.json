{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kaidomo/divvy-skill/release-conformance/v1/schema.json",
  "title": "Merge-triggered release conformance vector",
  "schema_version": 1,
  "type": "object",
  "required": ["name", "current_version", "title", "labels", "result"],
  "properties": {
    "name": {"type": "string"},
    "current_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "title": {"type": "string"},
    "labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "result": {"enum": ["major", "minor", "patch", "skip", "LABEL_CONFLICT", "LABEL_FLOOR_CONFLICT"]}
  },
  "additionalProperties": false
}
